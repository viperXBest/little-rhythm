# seed-demo settings. Copy to scripts/seed-demo/.env (gitignored) and fill in.
# Never commit real values. The script never prints them.

# Project URL and service-role key (hosted: Project Settings -> API; local: `supabase status`).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The two demo logins (created if missing, reset to these passwords if present).
# Use addresses only for the demo; the accounts get the fake names Ana and Radu.
DEMO_PARENT1_EMAIL=
DEMO_PARENT1_PASSWORD=
DEMO_PARENT2_EMAIL=
DEMO_PARENT2_PASSWORD=
